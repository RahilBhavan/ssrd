# Egress policy for the SSRD containers (applied inside the container's own netns).
# Default drop; allow DNS to the configured public resolvers and HTTP(S) to global addresses only.
# Only manage our own table: Docker's embedded-DNS NAT rules in this netns must survive.
table inet ssrd
delete table inet ssrd
table inet ssrd {
  set blocked4 {
    type ipv4_addr; flags interval
    elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12,
                 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24,
                 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 }
  }
  set resolvers4 { type ipv4_addr; elements = { 1.1.1.1, 8.8.8.8 } }
  chain output {
    type filter hook output priority 0; policy drop;
    oif "lo" accept
    ct state established,related accept
    ip daddr @resolvers4 udp dport 53 accept
    ip daddr @resolvers4 tcp dport 53 accept
    ip daddr @blocked4 counter drop
    meta nfproto ipv6 counter drop
    tcp dport { 80, 443 } accept
    counter drop
  }
  chain input {
    type filter hook input priority 0; policy drop;
    iif "lo" accept
    ct state established,related accept
  }
}
